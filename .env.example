# ===== Neon Postgres (ma'lumotlar bazasi) =====
# Pooler (branch) manzili — sslmode=require shart.
NEON_DATABASE_URL="postgresql://neondb_owner:...@ep-xxx-pooler.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ===== Neon Auth (Better Auth) =====
# Ro'yxatdan o'tish/kirish shu endpoint orqali. NEON_DATABASE_URL'dagi
# `ep-xxx-pooler.c-14...` o'rniga `ep-xxx.neonauth.c-14...` keladi.
NEON_AUTH_ISSUER="https://ep-xxx.neonauth.c-14.us-east-1.aws.neon.tech/neondb/auth"
# JWT tekshiruvi uchun (hozircha kod o'qimaydi — sessiya lokal tekshiriladi;
# tashqi token validatsiyasi qo'shilsa shu ishlatiladi).
NEON_JWKS_URL="https://ep-xxx.neonauth.c-14.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# ===== Fayl saqlash (Neon bazasida) =====
# Fayllar `public.storage_objects` jadvalida (bytea) saqlanadi — tashqi bucket,
# kalit va qo'shimcha xizmat kerak emas. Logo 2 MB, biriktirma 15 MB gacha;
# 15 MB Vercel so'rov chegarasidan oshmasligi uchun bo'laklab (3 MB) yuklanadi.
# Upload/download URL'lari qisqa muddatli HMAC token bilan imzolanadi.
# Maxfiy so'zi — ixtiyoriy. Bo'sh qolsa NEON_DATABASE_URL'dan HMAC hisoblanadi,
# shuning uchun hech narsa qo'shmasa ham ishlaydi. DB manzili o'zgarsa eski
# token'lar yaroqsiz bo'ladi (fayllarning o'zi joyida qoladi).
STORAGE_URL_SECRET=""

# ===== AI agent: OpenRouter (tavsiya etiladi) =====
# Kalit: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."
# Model (ixtiyoriy, default: google/gemini-2.5-flash)
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Yoki: to'g'ridan-to'g'ri Google Gemini
# Kalit: https://aistudio.google.com/apikey (bepul)
GEMINI_API_KEY="AIza..."

# ===== Telegram bot (BotFather tokeni) =====
TELEGRAM_BOT_TOKEN="123456:ABC..."
# Webhook maxfiy so'zi — ixtiyoriy. Bo'sh qolsa u token'dan HMAC bilan hisoblanadi
# (server va scripts/telegram-setup.mjs bir xil hisoblaydi). Token'ni aylantirmasdan
# maxfiy so'zni almashtirish uchun shu maydonga tasodifiy qator yozing.
TELEGRAM_WEBHOOK_SECRET=""

# ===== Saytning ochiq manzili (webhook uchun) =====
# Bo'lmasa https://www.nexora-crm.uz ishlatiladi.
PUBLIC_APP_URL="https://www.nexora-crm.uz"

# Kunlik hisobot va eslatma cron chaqiruvini himoyalash uchun
# (Vercel'da CRON_SECRET nomi bilan ham qabul qilinadi)
LOVABLE_CRON_SECRET=""

# Instagram (Meta Graph API) — ixtiyoriy
INSTAGRAM_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
# Meta webhook'ini tekshirish uchun (Instagram sahobingizni ulashga urinilganda
# shu qiymat so‘raladi; BotFather'dagi token bilan aralashtirmang).
INSTAGRAM_VERIFY_TOKEN=

# ===== To‘lov tizimlari (Payme / Click) =====
# Bularsiz "Tarif va to'lov" bo'limidagi obuna to'lovi ishlaydi, lekin to'lov
# hisob-kitobi "sozlanmagan" xatosini beradi.
PAYME_MERCHANT_ID=
PAYME_KEY=
# Test rejimi: 1 bo'lsa test payme tugmasi ishlatiladi.
PAYME_TEST=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ===== Platform belgilari =====
# Cron/webhook uchun ikkinchi nom (LOVABLE_CRON_SECRET bilan bir xil qiymat).
CRON_SECRET=
# Lovable platformidagi AI kaliti — OPENROUTER_API_KEY bo'lsa shu kerak emas.
LOVABLE_API_KEY=
# 1 bo'lsa error_events jadvaliga yozuv to'xtaydi (disk hajmi oshib ketmasa).
ERROR_EVENTS_DISABLED=
# NODE_ENV ni Vercel/Cloudflare o'zi beradi; lokal yozish shart emas.
# production'da /api/health tafsilotlarni yashiradi.
NODE_ENV=
